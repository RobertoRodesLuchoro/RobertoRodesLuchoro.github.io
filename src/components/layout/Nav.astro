---
import { NAV, PROFILE } from '../../config/site';
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-line/10 transition-[background-color,backdrop-filter] duration-500 data-[scrolled]:bg-bg/70 data-[scrolled]:backdrop-blur-xl"
>
  <div class="shell flex h-20 items-center justify-between gap-6">
    <a
      href="#top"
      class="font-display text-2xl uppercase tracking-wide text-ink transition-colors duration-300 hover:text-accent"
    >
      {PROFILE.firstName}
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a
                href={href}
                data-nav-link
                class="block px-4 py-2 text-sm font-semibold text-ink transition-[color,transform,scale] duration-300 ease-smooth hover:-translate-y-0.5 hover:text-accent active:scale-90 active:duration-100 aria-[current=true]:text-accent"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="#contacto"
      class="hidden md:inline-flex items-center rounded-full border border-line/30 px-6 py-2.5 text-sm font-semibold text-ink transition-[color,background-color,border-color,transform,scale] duration-300 ease-smooth hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-bg active:scale-90 active:duration-100"
    >
      Contacto
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-mobile"
      class="md:hidden -mr-2 grid size-11 place-items-center rounded-full border border-line/15"
    >
      <span class="sr-only">Abrir menú</span>
      <span class="relative block h-3 w-5">
        <span class="absolute inset-x-0 top-0 h-px bg-ink transition-transform duration-300"></span>
        <span class="absolute inset-x-0 bottom-0 h-px bg-ink transition-transform duration-300"></span>
      </span>
    </button>
  </div>

  <div id="nav-mobile" hidden class="md:hidden border-t border-line/10 bg-bg/95 backdrop-blur-xl">
    <ul class="shell flex flex-col py-4">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              data-nav-close
              class="block border-b border-line/5 py-4 text-display-sm font-semibold text-ink transition-colors duration-300 hover:text-accent"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#contacto" data-nav-close class="block py-4 text-display-sm text-accent">
          Contacto
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');

  // Fondo translúcido sólo cuando la página se ha desplazado.
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.setAttribute('data-scrolled', '');
    else nav.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Menú móvil.
  const setMenu = (open: boolean) => {
    if (!toggle || !mobile) return;
    toggle.setAttribute('aria-expanded', String(open));
    mobile.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  mobile?.querySelectorAll('[data-nav-close]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Al pinchar un elemento del header, cae desde arriba con rebote.
  // Con movimiento reducido la animación queda anulada desde CSS.
  const dropTargets = document.querySelectorAll<HTMLElement>(
    '#site-nav [data-nav-link], #site-nav a[href="#top"], #site-nav a[href="#contacto"], #nav-toggle'
  );

  dropTargets.forEach((el) => {
    el.addEventListener('click', () => {
      el.classList.remove('nav-drop');
      void el.offsetWidth; // reinicia la animación si se pincha en rápida sucesión
      el.classList.add('nav-drop');
    });
    el.addEventListener('animationend', () => el.classList.remove('nav-drop'));
  });

  // Sección activa. Se resuelve por posición en cada scroll en vez de por
  // IntersectionObserver: con saltos de ancla o scroll rápido varias secciones
  // entran a la vez y el observer dejaba ganar a la última del lote.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const entries = links
    .map((link) => {
      const id = link.getAttribute('href') || '';
      return { link, section: document.querySelector<HTMLElement>(id) };
    })
    .filter((e): e is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(e.section));

  if (entries.length) {
    const syncActive = () => {
      // Línea de referencia a un tercio de la ventana.
      const line = window.scrollY + window.innerHeight * 0.35;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

      let active = entries[0];
      for (const entry of entries) {
        if (entry.section.offsetTop <= line) active = entry;
      }
      // Al final de la página gana siempre la última sección alcanzable.
      if (atBottom) active = entries[entries.length - 1];

      for (const { link } of entries) {
        link.setAttribute('aria-current', String(link === active.link));
      }
    };

    let ticking = false;
    const onScrollSpy = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        syncActive();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScrollSpy, { passive: true });
    window.addEventListener('resize', onScrollSpy, { passive: true });
    syncActive();
  }
</script>
