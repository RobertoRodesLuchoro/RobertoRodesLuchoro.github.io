---
import { PROFILE } from '../../config/site';
import Reveal from '../ui/Reveal.astro';

/* Posición y ritmo de cada destello del fondo. */
const stars = [
  { left: '13%', top: '22%', size: '0.9rem', delay: '0s' },
  { left: '24%', top: '68%', size: '1.1rem', delay: '1.2s' },
  { left: '75%', top: '72%', size: '0.8rem', delay: '2.1s' },
  { left: '86%', top: '42%', size: '1rem', delay: '0.6s' },
  { left: '68%', top: '18%', size: '0.7rem', delay: '2.8s' },
] as const;
---

<section
  id="top"
  class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden pt-28 pb-16"
>
  <!-- Rejilla de fondo: brillante en el centro, oscura en los bordes. -->
  <div aria-hidden="true" class="hero-grid absolute inset-0 -z-10"></div>

  <!-- Halo de luz suave tras el contenido central. -->
  <div aria-hidden="true" class="hero-glow absolute inset-0 -z-10"></div>

  <!-- Destellos dispersos que parpadean lentamente. -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    {
      stars.map(({ left, top, size, delay }) => (
        <svg
          class="hero-star"
          style={`left:${left}; top:${top}; width:${size}; animation-delay:${delay}`}
          viewBox="0 0 24 24"
        >
          <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12C7.2 10.6 11.3 6.5 12 0Z" />
        </svg>
      ))
    }
  </div>

  <div class="shell flex w-full flex-col items-center text-center">
    {
      PROFILE.available && (
        <Reveal>
          <span class="mb-8 inline-flex items-center gap-3 rounded-full border border-accent/30 bg-accent/5 px-4 py-2 font-mono text-eyebrow uppercase text-accent">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60" />
              <span class="relative inline-flex size-2 rounded-full bg-accent" />
            </span>
            {PROFILE.availableLabel}
          </span>
        </Reveal>
      )
    }

    <Reveal delay={120}>
      <p class="text-display-md font-semibold text-ink">Hola, soy {PROFILE.name.split(' ').slice(0, 2).join(' ')}</p>
    </Reveal>

    <Reveal delay={260}>
      <h1 class="mt-2">
        <span class="sr-only">{PROFILE.role}</span>
        <span
          id="hero-role"
          aria-hidden="true"
          class="hero-role"
          data-roles={JSON.stringify(PROFILE.heroRoles)}
        >
          {PROFILE.heroRoles[0]}
        </span>
      </h1>
    </Reveal>

    <Reveal delay={400}>
      <p class="mt-8 text-lead text-muted">
        {PROFILE.heroTagline.map((line) => <span class="block">{line}</span>)}
      </p>
    </Reveal>
  </div>

  <div class="shell mt-32 flex flex-col items-center md:mt-40">
    <Reveal delay={550}>
      <a href="#proyectos" class="group flex flex-col items-center gap-5 text-center">
        <span class="text-display-sm font-bold leading-tight text-ink">
          Proyectos<br />recientes
        </span>
        <svg
          class="w-12 text-accent transition-transform duration-500 ease-smooth group-hover:translate-y-1.5 motion-safe:animate-bounce"
          viewBox="0 0 24 14"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M0 0l12 8L24 0v6L12 14 0 6V0Z" />
        </svg>
      </a>
    </Reveal>
  </div>
</section>

<script>
  // --- Rotación del rol del hero --------------------------------------
  const el = document.getElementById('hero-role');
  const roles: string[] = el?.dataset.roles ? JSON.parse(el.dataset.roles) : [];

  if (el && roles.length > 1) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    setInterval(() => {
      i = (i + 1) % roles.length;

      if (reduceMotion) {
        el.textContent = roles[i];
        return;
      }

      // Sale hacia arriba, se cambia el texto y entra desde abajo.
      el.classList.add('is-out');
      setTimeout(() => {
        el.textContent = roles[i];
        el.classList.add('is-prep');
        el.classList.remove('is-out');
        void el.offsetHeight; // fuerza reflow para que la entrada se anime
        el.classList.remove('is-prep');
      }, 450);
    }, 2800);
  }
</script>
