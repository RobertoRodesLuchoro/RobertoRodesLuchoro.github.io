---
import { STACK } from '../../config/site';
import { techLabel } from '../../config/tech';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import TechIcon from '../ui/TechIcon.astro';
---

<section id="stack" class="py-section">
  <div class="shell">
    <SectionHeader index="03" eyebrow="Herramientas" title="Stack técnico" class="mb-20" />

    <div class="flex flex-col">
      {
        STACK.map((group, i) => (
          <Reveal delay={i * 80}>
            {/* Categoría a la izquierda, tecnologías a la derecha. */}
            <div class="grid gap-6 border-t border-line/10 py-10 md:grid-cols-12 md:gap-10">
              <h3 class="md:col-span-3 font-mono text-eyebrow uppercase text-muted">
                {group.group}
              </h3>

              <ul class="md:col-span-9 flex flex-wrap gap-x-8 gap-y-6">
                {group.items.map((tech) => (
                  <li class="group/item flex items-center gap-3">
                    <TechIcon
                      name={tech}
                      class="size-7 opacity-70 transition-opacity duration-300 group-hover/item:opacity-100"
                    />
                    <span class="text-body text-muted transition-colors duration-300 group-hover/item:text-ink">
                      {techLabel(tech)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
