---
/** Envoltorio que desvanece y eleva su contenido al entrar en viewport. */
interface Props {
  delay?: number;
  as?: string;
  class?: string;
}

const { delay = 0, as = 'div', class: className = '' } = Astro.props as Props;

// La etiqueta es dinámica, así que TypeScript no puede validar sus atributos.
const Tag = as as any;
---

<Tag data-reveal class={className} style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <slot />
</Tag>
