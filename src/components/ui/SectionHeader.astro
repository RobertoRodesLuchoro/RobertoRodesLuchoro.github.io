---
import Reveal from './Reveal.astro';
import SplitLines from './SplitLines.astro';

/** Cabecera común: índice + etiqueta en mono sobre un titular grande. */
interface Props {
  eyebrow: string;
  title: string;
  index?: string;
  class?: string;
}

const { eyebrow, title, index, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-6 ${className}`}>
  <Reveal class="flex items-center gap-4">
    {index && <span class="font-mono text-eyebrow text-muted">{index}</span>}
    <span class="eyebrow">{eyebrow}</span>
    <span class="h-px flex-1 bg-line/10"></span>
  </Reveal>

  <SplitLines lines={[title]} class="text-display-md" />
</div>
